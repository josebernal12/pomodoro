---
interface Props {
  appName: string;
}

const { appName } = Astro.props;
---

<header class="topbar">
  <h2 class="sr-only">{appName}</h2>
  <div class="today" aria-live="polite">
    <span class="today-label">Hoy</span>
    <span class="today-dots" aria-hidden="true" data-today-dots></span>
    <span class="sr-only" data-today-count>0 ventanas hoy</span>
  </div>
</header>
