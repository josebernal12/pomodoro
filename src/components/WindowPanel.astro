---
// Para sumar un ambiente: carpeta en public/scenes/<id>/ con background.webp, y su id también en
// sceneIds (src/scripts/pomodoro.js) y en el CSS de .scene-layer. `animated` marca los que se mueven.
const windows = [
  { id: "cat-rain-window", label: "Lluvia nocturna", animated: false },
  { id: "cat-sunset-room", label: "Atardecer suave", animated: false },
  { id: "cat-tea-room", label: "Jardín con lluvia", animated: false },
  { id: "cat-snow-window", label: "Nieve tranquila", animated: false },
];
---

<aside class="windows-panel" hidden data-windows-panel aria-label="Ambientes">
  <span class="scene-tip" aria-hidden="true" data-scene-tip></span>
  <div class="scene-strip" role="group" aria-label="Elige tu ambiente">
    <div class="scene-strip-track" data-scene-track>
      {
        windows.map((window) => (
          <button
            class="scene-thumb"
            type="button"
            data-scene-option={window.id}
            data-name={window.label}
            data-animated={window.animated ? "true" : "false"}
            aria-label={window.animated ? `${window.label}, animado` : window.label}
          >
            <img class="scene-thumb-image" src={`/scenes/${window.id}/background.webp`} alt="" decoding="async" />
            {window.animated && (
              <span class="scene-thumb-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l11-6.5z" /></svg>
              </span>
            )}
          </button>
        ))
      }
    </div>
    <button class="scene-strip-next" type="button" aria-label="Ver más ambientes" hidden data-scene-next>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg>
    </button>
    <button class="window-close-button" type="button" aria-label="Cerrar ambientes" data-windows-close>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
</aside>
