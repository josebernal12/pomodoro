<aside class="extensions-panel" hidden data-extensions-panel aria-label="Extensiones">
  <div class="panel-head">
    <h2 class="panel-title">Extensiones</h2>
    <button class="panel-close-button" type="button" aria-label="Cerrar extensiones" data-extensions-close>
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <label class="extension-card">
    <span class="extension-copy">
      <strong>Cuaderno</strong>
      <span>Organiza tareas y conserva tu lista de trabajo.</span>
    </span>
    <span class="switch">
      <input type="checkbox" data-extension-toggle="notebook" />
      <span aria-hidden="true"></span>
    </span>
  </label>
</aside>
