<button class="icon-button windows-toggle" type="button" aria-label="Abrir ventanas" data-windows-toggle>
  <img class="floating-cat-icon" src="/icons/cats/window.png" alt="" aria-hidden="true" />
</button>

<button class="icon-button notebook-toggle" type="button" aria-label="Abrir cuaderno" data-notebook-toggle hidden>
  <span class="notebook-icon" aria-hidden="true"></span>
</button>

<button class="icon-button ost-toggle" type="button" aria-label="Abrir banda sonora" data-ost-toggle>
  <span aria-hidden="true">♫</span>
</button>

<button class="icon-button extensions-toggle" type="button" aria-label="Abrir extensiones" data-extensions-toggle>
  <span class="extensions-icon" aria-hidden="true"></span>
</button>

<button class="icon-button settings-toggle" type="button" aria-label="Abrir ajustes" data-settings-toggle>
  <span aria-hidden="true">&#9881;</span>
</button>

<button class="icon-button floating-toggle" type="button" aria-label="Abrir timer flotante" data-floating-toggle>
  <span aria-hidden="true">&#8599;</span>
</button>

<button class="install-button" type="button" hidden data-install-button>Instalar app</button>
